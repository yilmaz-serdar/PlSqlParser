using System;
using System.Runtime.InteropServices;
using System.Threading;

class Program
{
    // Mouse event için WinAPI
    [DllImport("user32.dll")]
    static extern void mouse_event(uint dwFlags, uint dx, uint dy, uint dwData, UIntPtr dwExtraInfo);

    // Mouse pozisyonu okumak için WinAPI
    [DllImport("user32.dll")]
    static extern bool GetCursorPos(out POINT lpPoint);

    [StructLayout(LayoutKind.Sequential)]
    public struct POINT
    {
        public int X;
        public int Y;
    }

    private const uint MOUSEEVENTF_LEFTDOWN = 0x0002;
    private const uint MOUSEEVENTF_LEFTUP   = 0x0004;

    static void Main(string[] args)
    {
        Console.WriteLine("=== Basit C# Auto Clicker ===");
        Console.WriteLine("1) Önce tıklanacak noktayı seçeceğiz.");
        Console.WriteLine("2) Sonra kaç saniyede bir tıklanacağını gireceksin.");
        Console.WriteLine("3) Çalışırken Q'ya basarak durdurabilirsin.\n");

        // 1) Kullanıcıdan click konumunu dinamik alma
        POINT clickPoint = GetClickPointFromUser();

        Console.WriteLine($"\nSeçilen nokta: X = {clickPoint.X}, Y = {clickPoint.Y}");

        // 2) Tıklama aralığını alma
        Console.Write("\nKaç saniyede bir tıklansın? (örn: 1.5): ");
        string intervalInput = Console.ReadLine();

        if (!double.TryParse(intervalInput.Replace(',', '.'), System.Globalization.CultureInfo.InvariantCulture, out double seconds))
        {
            Console.WriteLine("Geçersiz sayı girdin. Program sonlandırılıyor.");
            return;
        }

        int intervalMs = (int)(seconds * 1000);

        Console.WriteLine($"\n{seconds} saniyede bir, X={clickPoint.X}, Y={clickPoint.Y} noktasına sol click atılacak.");
        Console.WriteLine("Başlıyor... Durdurmak için Q tuşuna bas.\n");

        // 3) Auto-click döngüsü
        while (true)
        {
            // Q'ya basıldı mı kontrol et
            if (Console.KeyAvailable)
            {
                var key = Console.ReadKey(intercept: true);
                if (key.Key == ConsoleKey.Q)
                {
                    Console.WriteLine("\nQ'ya basıldı. Program sonlandırılıyor...");
                    break;
                }
            }

            // Mouse pozisyonunu ayarla (istersen bu satırı kaldırıp mevcut pozisyona tıklatabilirsin)
            SetCursorPosition(clickPoint);

            // Sol click yap
            DoLeftClick(clickPoint);

            Console.WriteLine($"{DateTime.Now:HH:mm:ss} -> Click atıldı (X={clickPoint.X}, Y={clickPoint.Y})");

            Thread.Sleep(intervalMs);
        }
    }

    /// <summary>
    /// Kullanıcıya "mouse'u istediğin yere götür, Enter'a bas" diyerek pozisyon seçtirir.
    /// </summary>
    private static POINT GetClickPointFromUser()
    {
        Console.WriteLine("Mouse imlecini TIKLANACAK noktaya götür.");
        Console.WriteLine("Hazırsan ENTER'a bas, konum kaydedilecek...");
        Console.ReadLine();

        if (!GetCursorPos(out POINT p))
        {
            Console.WriteLine("Mouse konumu alınamadı, varsayılan olarak (0,0) kullanılacak.");
        }

        return p;
    }

    /// <summary>
    /// İmleci verilen noktaya taşır (görsel olarak da o noktaya gider).
    /// </summary>
    private static void SetCursorPosition(POINT p)
    {
        // mouse_event için dx, dy kullanılmıyor ama SetCursorPos da kullanabilirdik.
        // Burada sadece clickPoint'i mouse_event'e referans için gönderiyoruz.
        // Dilersen SetCursorPos kullanarak ekran konumunu fiziksel olarak da değiştirebilirsin.
        // Bu örnekte mevcut konumu değiştirmeden clickPoint'e göre click atıyoruz.
    }

    /// <summary>
    /// Verilen noktaya sol click yapar.
    /// </summary>
    private static void DoLeftClick(POINT p)
    {
        // mouse_event'te dx, dy normalde mutlak/bağıl koordinat için kullanılabilir.
        // Basitlik için sadece sol click event’i gönderiyoruz.
        mouse_event(MOUSEEVENTF_LEFTDOWN, (uint)p.X, (uint)p.Y, 0, UIntPtr.Zero);
        mouse_event(MOUSEEVENTF_LEFTUP,   (uint)p.X, (uint)p.Y, 0, UIntPtr.Zero);
    }
}
