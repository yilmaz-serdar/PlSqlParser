public List<Dictionary<string, string>> ParseExplainPlan(string[] lines)
{
    var headerLine = lines.FirstOrDefault(x =>
        x.Contains("| Id") && x.Contains("Operation"));

    if (headerLine == null)
        return new List<Dictionary<string, string>>();

    var headers = headerLine
        .Split('|', StringSplitOptions.RemoveEmptyEntries)
        .Select(h => h.Trim())
        .ToList();

    int headerIndex = Array.IndexOf(lines, headerLine);

    var dataLines = lines
        .Skip(headerIndex + 1)
        .Where(x => x.StartsWith("|"))
        .ToList();

    var result = new List<Dictionary<string, string>>();

    foreach (var line in dataLines)
    {
        var cols = line
            .Split('|', StringSplitOptions.RemoveEmptyEntries)
            .Select(c => c.Trim())
            .ToList();

        if (cols.Count != headers.Count)
            continue;

        var dict = new Dictionary<string, string>();

        for (int i = 0; i < headers.Count; i++)
            dict[headers[i]] = cols[i];

        result.Add(dict);
    }

    return result;
}
