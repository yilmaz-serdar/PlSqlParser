/* SELECT2 – Normal combobox stiline benzeyecek şekilde düzenleme */
.select2-container--default .select2-selection--single {
    height: 38px !important;            /* Orijinal input yüksekliği */
    border: 1px solid #ced4da !important;
    border-radius: 4px !important;       /* Sağdaki combonun radius’u */
    padding: 5px 10px !important;
    font-size: 14px;
    display: flex;
    align-items: center;                 /* Yazıyı dikey ortala */
    background-color: #fff;
}

/* Seçilen text hizalama */
.select2-container--default .select2-selection__rendered {
    line-height: 28px !important; 
    color: #495057 !important;
    font-size: 14px;
    padding-left: 0 !important;          /* Fazla padding’i kaldır */
}

/* Açılır ok ikonu hizalama */
.select2-container--default .select2-selection__arrow {
    height: 100% !important;
    right: 8px !important;
}

/* Hover rengi */
.select2-container--default .select2-selection--single:hover {
    border-color: #b3b3b3 !important;
}

/* Focus efekti */
.select2-container--default.select2-container--focus .select2-selection--single {
    border-color: #80bdff !important;
    box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25) !important;
}

/* Dropdown menü */
.select2-container--default .select2-results__option {
    font-size: 14px;
    padding: 6px 10px;
}

.select2-container--default .select2-results__option--highlighted {
    background-color: #007bff !important;
    color: white !important;
}


/* Select2 Focus - Mor (#9c27b0) */
.select2-container--default.select2-container--focus .select2-selection--single {
    border-color: #9c27b0 !important;
    box-shadow: 0 0 0 0.2rem rgba(156, 39, 176, 0.25) !important;
}

/* Dropdown açıkken yukarıdaki stil geçerli olsun */
.select2-container--default .select2-selection--single:focus {
    border-color: #9c27b0 !important;
    box-shadow: 0 0 0 0.2rem rgba(156, 39, 176, 0.25) !important;
    outline: none !important;
}
