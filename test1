public class ServiceGraphDto
{
    public List<ServiceNodeDto> Nodes { get; set; }
    public List<ServiceEdgeDto> Edges { get; set; }
}

public class ServiceNodeDto
{
    public string Id { get; set; }
    public string Label { get; set; }
}

public class ServiceEdgeDto
{
    public string Source { get; set; }
    public string Target { get; set; }
    public string CallType { get; set; }
}


{
  "nodes": [
    { "id": "X", "label": "X Servisi" },
    { "id": "Y", "label": "Y Servisi" },
    { "id": "Z", "label": "Z Servisi" },
    { "id": "T", "label": "T Servisi" }
  ],
  "edges": [
    { "source": "X", "target": "Y", "callType": "REST" },
    { "source": "Y", "target": "Z", "callType": "gRPC" },
    { "source": "Y", "target": "T", "callType": "SOAP" }
  ]
}


<div id="serviceGraph" style="width:100%; height:600px; border:1px solid #ddd;"></div>

<script src="https://unpkg.com/cytoscape/dist/cytoscape.min.js"></script>

<script>
    const graphData = {
        nodes: [
            { id: "X", label: "X Servisi" },
            { id: "Y", label: "Y Servisi" },
            { id: "Z", label: "Z Servisi" },
            { id: "T", label: "T Servisi" }
        ],
        edges: [
            { source: "X", target: "Y", callType: "REST" },
            { source: "Y", target: "Z", callType: "gRPC" },
            { source: "Y", target: "T", callType: "SOAP" }
        ]
    };

    const elements = [
        ...graphData.nodes.map(n => ({
            data: { id: n.id, label: n.label }
        })),
        ...graphData.edges.map(e => ({
            data: {
                source: e.source,
                target: e.target,
                label: e.callType
            }
        }))
    ];

    cytoscape({
        container: document.getElementById('serviceGraph'),
        elements: elements,
        style: [
            {
                selector: 'node',
                style: {
                    'label': 'data(label)',
                    'background-color': '#1976d2',
                    'color': '#fff',
                    'text-valign': 'center',
                    'text-halign': 'center',
                    'width': 90,
                    'height': 45,
                    'shape': 'round-rectangle'
                }
            },
            {
                selector: 'edge',
                style: {
                    'label': 'data(label)',
                    'curve-style': 'bezier',
                    'target-arrow-shape': 'triangle',
                    'line-color': '#999',
                    'target-arrow-color': '#999',
                    'font-size': 12,
                    'text-background-color': '#fff',
                    'text-background-opacity': 1,
                    'text-background-padding': 3
                }
            }
        ],
        layout: {
            name: 'breadthfirst',
            directed: true,
            padding: 30
        }
    });
</script>
