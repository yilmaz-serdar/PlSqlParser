WITH HourlyUsage AS
(
    SELECT
        TRUNC(ObjStat.START_TIME, 'HH24') AS IntervalStart,
        SUM(ObjStat.USAGE_COUNT) AS UsageCount
    FROM {SCHEMA_NAME}.{SERVICE_NAME}_OBJECT_STAT ObjStat
    WHERE EXISTS
    (
        SELECT 1
        FROM {SCHEMA_NAME}.{SERVICE_NAME}_OBJECT ObjInfo
        WHERE ObjInfo.SQL_ID = ObjStat.SQL_ID
          AND ObjInfo.OBJECT_NAME = '{OBJECT_NAME}'
    )
      AND ObjStat.START_TIME >= TO_DATE(
            '{START_TIME}',
            'DD-MM-YYYY HH24:MI:SS'
          )
      AND ObjStat.START_TIME < TO_DATE(
            '{END_TIME}',
            'DD-MM-YYYY HH24:MI:SS'
          )
    GROUP BY
        TRUNC(ObjStat.START_TIME, 'HH24')
),
AverageUsageByHour AS
(
    SELECT
        TO_NUMBER(TO_CHAR(IntervalStart, 'HH24')) AS HourOfDay,
        AVG(UsageCount) AS AverageUsageCount,
        COUNT(*) AS SampleCount
    FROM HourlyUsage
    GROUP BY
        TO_NUMBER(TO_CHAR(IntervalStart, 'HH24'))
)
SELECT
    LPAD(HourOfDay, 2, '0') || ':00' AS IntervalStart,
    LPAD(MOD(HourOfDay + 1, 24), 2, '0') || ':00' AS IntervalEnd,
    ROUND(AverageUsageCount, 2) AS AverageUsageCount,
    SampleCount
FROM AverageUsageByHour
ORDER BY HourOfDay;


