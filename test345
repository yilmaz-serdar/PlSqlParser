<div id="global-loader" class="global-loader" aria-hidden="true">
  <div class="global-loader__content">
    <div class="spinner"></div>
    <div class="text">Yükleniyor...</div>
  </div>
</div>


.global-loader{
  position: fixed;
  inset: 0;
  display: none;              /* default gizli */
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,.7);
  z-index: 99999;
}

.global-loader.is-active{ display: flex; }

.spinner{
  width: 42px;
  height: 42px;
  border: 4px solid #ddd;
  border-top-color: #333;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }


(function () {
  const loader = document.getElementById("global-loader");
  if (!loader) return;

  let pending = 0;
  let showTimer = null;

  function showLoader() {
    // 150ms gecikme: çok hızlı isteklerde "flicker" olmasın
    if (showTimer) return;
    showTimer = setTimeout(() => {
      loader.classList.add("is-active");
      loader.setAttribute("aria-hidden", "false");
      showTimer = null;
    }, 150);
  }

  function hideLoader() {
    if (showTimer) { clearTimeout(showTimer); showTimer = null; }
    loader.classList.remove("is-active");
    loader.setAttribute("aria-hidden", "true");
  }

  function inc() { pending++; showLoader(); }
  function dec() { pending = Math.max(0, pending - 1); if (pending === 0) hideLoader(); }

  // 1) İlk sayfa yükleme: hemen göster, window.load ile gizle
  loader.classList.add("is-active");
  window.addEventListener("load", () => {
    pending === 0 && hideLoader();
  });

  // 2a) fetch'leri global yakala
  if (window.fetch) {
    const originalFetch = window.fetch;
    window.fetch = function (...args) {
      inc();
      return originalFetch.apply(this, args)
        .finally(dec);
    };
  }

  // 2b) XMLHttpRequest (jQuery $.ajax da buradan geçer)
  const origOpen = XMLHttpRequest.prototype.open;
  const origSend = XMLHttpRequest.prototype.send;

  XMLHttpRequest.prototype.open = function (...args) {
    this.__trackLoader = true; // istersen bazı endpoint'leri hariç tutabilirsin
    return origOpen.apply(this, args);
  };

  XMLHttpRequest.prototype.send = function (...args) {
    if (this.__trackLoader) inc();

    this.addEventListener("loadend", () => {
      if (this.__trackLoader) dec();
    });

    return origSend.apply(this, args);
  };

  // İstersen global erişim:
  window.GlobalLoader = { show: inc, hide: dec };
})();
