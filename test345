using System.Data;
using System.Data.Common;

public abstract class RepositoryBase
{
    private readonly Func<DbConnection> _connectionFactory;

    protected RepositoryBase(Func<DbConnection> connectionFactory)
    {
        _connectionFactory = connectionFactory;
    }

    protected async Task<T> WithConnection<T>(
        DbConnection? externalConn,
        Func<DbConnection, Task<T>> work,
        CancellationToken ct = default)
    {
        if (externalConn is not null)
        {
            // Dışarıdan geldiyse: aç/kapat/Dispose sana ait değil
            return await work(externalConn);
        }

        await using var conn = _connectionFactory();
        if (conn.State != ConnectionState.Open)
            await conn.OpenAsync(ct);

        return await work(conn);
    }

    protected async Task WithConnection(
        DbConnection? externalConn,
        Func<DbConnection, Task> work,
        CancellationToken ct = default)
    {
        await WithConnection(externalConn, async c => { await work(c); return 0; }, ct);
    }
}
