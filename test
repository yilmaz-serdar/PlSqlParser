<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>

const dbStats = [
    { DbName: "PVPOS", Count: 120 },
    { DbName: "PMOBIL", Count: 80 }
];

const schemaStats = [
    { SchemaName: "CORE", Count: 50 },
    { SchemaName: "LOG", Count: 30 }
];

function exportExcel() {

    const workbook = XLSX.utils.book_new();

    // Sheet 1
    const ws1 = XLSX.utils.json_to_sheet(dbStats);
    XLSX.utils.book_append_sheet(workbook, ws1, "Database");

    // Sheet 2
    const ws2 = XLSX.utils.json_to_sheet(schemaStats);
    XLSX.utils.book_append_sheet(workbook, ws2, "Schema");

    XLSX.writeFile(workbook, "Report.xlsx");
}
